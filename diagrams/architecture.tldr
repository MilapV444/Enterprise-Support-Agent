            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "  account + agent-side user check"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "\u2022 Retry reads with backoff \u00b7 breaker"
                }
