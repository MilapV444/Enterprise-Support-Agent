        "fill": "semi",
        "size": "s",
        "font": "sans",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "HAND-OFFS TO OTHER COMPONENTS"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Comp 2: coordinator + specialist subgraphs; step caps beside ADP-04"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Comp 5: allow-lists per specialist (reads + low-risk writes); higher-risk writes via coordinator"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Comp 9: delegation + conflict tests \u00b7 Comp 12: tokens + model per specialist"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Comp 13: low-confidence delegation, blocked results, numeric conflicts"
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "OWNED RISKS TO WATCH"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "KU1 token cost \u00b7 KU2 claim scoring \u00b7 KU3 latency"
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Full reasoning: checkpoint.md \u00a79"
                }
              ]
            }
          ]
        }
      }
    },
