# Copy to .env and fill in. Learning deployment profile: free tiers only, total spend <= USD 10/month (SPEC.md NFR-36).
MONTHLY_SPEND_CAP_USD=10

# Local backbone (deploy/compose.yaml)
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent
OPENBAO_DEV_TOKEN=change-me

# Optional free managed replacements (leave empty to use the local containers)
DATABASE_URL=
QDRANT_URL=
QDRANT_API_KEY=

# Free managed services
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Models: free tiers by default; Claude only for the hardest turns.
# Set a USD 10 monthly spend limit in the Anthropic console before adding this key.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
