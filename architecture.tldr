                  "text": "\u2022 Raw user input from the web widget (HTTPS)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "\u2022 IdP tokens (SSO) \u00b7 one-time codes (T1)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "\u2022 On return: gated response envelope (Comp 7 / 9 / 13)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "\u2022 Deferred outcome events from workflows (Comp 2)"
                }
              ]
            }
          ]
        }
      }
    },
