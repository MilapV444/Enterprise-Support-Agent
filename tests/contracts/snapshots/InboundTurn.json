{
 "$defs": {
  "TurnAction": {
   "description": "A customer action from a card instead of a typed message: raise a proposed ticket (FR-47), or carry out\nan offered service action (tools.services).",
   "properties": {
    "proposal": {
     "pattern": "^(TKT|ACT)-[0-9]{5,}$",
     "title": "Proposal",
     "type": "string"
    },
    "type": {
     "enum": [
      "confirm_ticket",
      "confirm_action"
     ],
     "title": "Type",
     "type": "string"
    }
   },
   "required": [
    "type",
    "proposal"
   ],
   "title": "TurnAction",
   "type": "object"
  }
 },
 "description": "What the orchestrator receives for one accepted turn.",
 "properties": {
  "action": {
   "anyOf": [
    {
     "$ref": "#/$defs/TurnAction"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "assurance_tier": {
   "title": "Assurance Tier",
   "type": "string"
  },
  "attachment_refs": {
   "items": {
    "type": "string"
   },
   "title": "Attachment Refs",
   "type": "array"
  },
  "channel": {
   "default": "WEB_WIDGET",
   "title": "Channel",
   "type": "string"
  },
  "content": {
   "title": "Content",
   "type": "string"
  },
  "conversation_id": {
   "title": "Conversation Id",
   "type": "string"
  },
  "principal_id": {
   "title": "Principal Id",
   "type": "string"
  },
  "received_at": {
   "format": "date-time",
   "title": "Received At",
   "type": "string"
  },
  "session_id": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Session Id"
  },
  "tenant_id": {
   "title": "Tenant Id",
   "type": "string"
  },
  "turn_id": {
   "title": "Turn Id",
   "type": "string"
  }
 },
 "required": [
  "tenant_id",
  "principal_id",
  "assurance_tier",
  "conversation_id",
  "turn_id",
  "content",
  "attachment_refs"
 ],
 "title": "InboundTurn",
 "type": "object"
}
