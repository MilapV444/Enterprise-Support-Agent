# Build context for deploy/vm/Dockerfile (BuildKit reads <Dockerfile>.dockerignore next to the Dockerfile).
# Allow-list: everything is excluded, then only what the image copies is let back in.
**
!pyproject.toml
!src/**
!evals/**
!migrations/**
!policies/**
!deploy/vm/**
# never in an image, wherever they sit
**/.env
**/.env.*
**/*.key
**/*.pem
**/__pycache__
**/*.py[cod]
